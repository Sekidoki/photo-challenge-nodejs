{
  "name": "photo-challenge-nodejs",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js rewrite scaffold for Wikimedia Commons Photo Challenge tooling",
  "main": "dist/server.js",
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json --outDir .test-dist --noEmit false",
    "dev": "tsx watch src/server.ts",
    "dev:nodemon": "nodemon --watch src --ext ts,handlebars,css --exec tsx src/server.ts",
    "start": "node dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build:test && node .test-dist/tests/run.js",
    "report:web-vitals": "node scripts/report-web-vitals.mjs"
  },
  "dependencies": {
    "@wikimedia/codex-design-tokens": "2.6.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "keytar": "^7.9.0",
    "luxon": "^3.7.2",
    "mwn": "^3.0.3",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false,
    "keytar@7.9.0": true
  }
}
