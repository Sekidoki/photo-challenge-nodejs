{
  "name": "photo-challenge-nodejs",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js rewrite scaffold for Wikimedia Commons Photo Challenge tooling",
  "main": "dist/server.js",
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json --outDir .test-dist --noEmit false",
    "dev": "tsx watch --include \"src/**/*\" src/server.ts",
    "start": "node dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:test": "tsc --noEmit -p tsconfig.test.json",
    "check:assets": "node scripts/check-web-assets.mjs",
    "test": "npm run build:test && node .test-dist/tests/run.js",
    "report:web-vitals": "node scripts/report-web-vitals.mjs"
  },
  "dependencies": {
    "@wikimedia/codex-design-tokens": "2.7.0",
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.2",
    "keytar": "^7.9.0",
    "luxon": "^3.7.2",
    "mwn": "^3.0.3",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false,
    "keytar@7.9.0": true
  }
}
