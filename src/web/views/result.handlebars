<div class="bento">
  <header class="page-header">
    <h1>{{t "result.titleWithChallenge" challenge=job.challenge}}</h1>
    {{> workflow-steps steps=workflowSteps}}
    <dl class="details">
      <div><dt>{{t "common.action"}}</dt><dd>{{jobActionLabel}}</dd></div>
      <div><dt>{{t "status.label"}}</dt><dd>{{statusLabel}}</dd></div>
    </dl>
  </header>

  {{> flash-notice notice=publishNotice}}

  {{#if leaderboard.length}}
    <section class="tile span-8 result-leaderboard" aria-labelledby="result-leaderboard-heading">
      <h2 id="result-leaderboard-heading">{{t "result.top.heading"}}</h2>
      <ol class="result-ranking">
        {{#each leaderboard}}
          <li class="result-ranking-item">
            <p class="result-rank">{{t "result.top.rank" rank=rank}}</p>
            <div class="result-images">
              {{#each images}}
                <a class="result-image-link" href="{{fileUrl}}" target="_blank" rel="noopener noreferrer">
                  <img src="{{thumbnailUrl}}" alt="{{title}}" width="480" height="360" loading="lazy" decoding="async" />
                  <span class="result-image-fallback" aria-hidden="true">{{title}}</span>
                  <span class="visually-hidden">({{t "accessibility.opensNewTab"}})</span>
                </a>
              {{/each}}
            </div>
            <dl class="result-winner-details">
              <div>
                <dt>{{t "result.top.author"}}</dt>
                <dd><a href="{{creatorUrl}}" target="_blank" rel="noopener noreferrer">{{creator}}<span class="visually-hidden"> ({{t "accessibility.opensNewTab"}})</span></a></dd>
              </div>
              <div>
                <dt>{{t "result.top.score"}}</dt>
                <dd>{{score}}</dd>
              </div>
              {{#if support}}
                <div>
                  <dt>{{t "result.top.support"}}</dt>
                  <dd>{{support}}</dd>
                </div>
              {{/if}}
            </dl>
          </li>
        {{/each}}
      </ol>
    </section>
  {{/if}}

  {{#*inline "nextStep"}}
    {{#if canPublishReview}}
      <section class="tile next-step" aria-labelledby="next-step-heading">
        <h2 id="next-step-heading">{{t "result.nextStep"}}</h2>
        <a class="button-link button-primary" href="{{publishReviewUrl}}">{{t "result.reviewPublish" mode=publishModeLabel}}</a>
      </section>
    {{else}}
      {{#if hasMaintenanceReview}}
        <section class="tile next-step" aria-labelledby="next-step-heading">
          <h2 id="next-step-heading">{{t "result.nextStep"}}</h2>
          <a class="button-link button-primary" href="{{maintenanceReviewUrl}}">{{t "result.openMaintenance"}}</a>
          <p class="next-step-copy">{{t "result.maintenanceCopy"}}</p>
        </section>
      {{/if}}
    {{/if}}
  {{/inline}}

  {{#*inline "secondaryFiles"}}
    <div class="tile {{extraClass}}">
      <details class="artifact-disclosure">
        <summary>{{t "result.other"}} ({{generatedFiles.length}})</summary>
        {{#if generatedFiles.length}}
          <ul class="artifact-list">
            {{#each generatedFiles}}
              <li><code>{{name}}</code><span class="link-actions"><a href="{{previewUrl}}">{{t "common.preview"}}<span class="visually-hidden"> · {{name}}</span></a><a href="{{downloadUrl}}">{{t "common.download"}}<span class="visually-hidden"> · {{name}}</span></a></span></li>
            {{/each}}
          </ul>
        {{else}}
          <p class="empty-state">{{t "result.noOther"}}</p>
        {{/if}}
      </details>

      <details class="artifact-disclosure">
        <summary>{{t "result.logs"}} ({{logFiles.length}})</summary>
        {{#if logFiles.length}}
          <ul class="artifact-list">
            {{#each logFiles}}
              <li><code>{{name}}</code><span class="link-actions"><a href="{{previewUrl}}">{{t "common.preview"}}<span class="visually-hidden"> · {{name}}</span></a><a href="{{downloadUrl}}">{{t "common.download"}}<span class="visually-hidden"> · {{name}}</span></a></span></li>
            {{/each}}
          </ul>
        {{else}}
          <p class="empty-state">{{t "result.noLogs"}}</p>
        {{/if}}
        {{#unless oauthConfigured}}<p class="output-path"><span>{{t "common.output"}}</span> {{> copy-path path=job.outputDir}}</p>{{/unless}}
      </details>
    </div>
  {{/inline}}

  {{#*inline "coreOutputs"}}
    <section class="tile {{extraClass}}" aria-labelledby="core-heading">
      <h2 id="core-heading">{{t "result.core"}}</h2>
      {{#if coreArtifacts.length}}
        <ul class="artifact-list">
          {{#each coreArtifacts}}
            <li>
              <span class="artifact-name"><strong>{{label}}</strong><code>{{name}}</code><span class="artifact-copy">{{description}}</span></span>
              <span class="link-actions"><a href="{{previewUrl}}">{{t "common.preview"}}<span class="visually-hidden"> · {{label}}</span></a><a href="{{downloadUrl}}">{{t "common.download"}}<span class="visually-hidden"> · {{label}}</span></a></span>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="empty-state">{{t "result.noCore"}}</p>
      {{/if}}
    </section>
  {{/inline}}

  {{#if leaderboard.length}}
    {{!-- Leaderboard leads at 8 of 12 columns; the next step, run totals and
         folded file lists stack beside it, then core outputs run full width. --}}
    <div class="bento-stack span-4">
      {{> nextStep}}
      {{#if runStats}}
        <section class="tile" aria-labelledby="run-stats-heading">
          <h2 id="run-stats-heading">{{t "result.stats.heading"}}</h2>
          <dl class="run-stats">
            <div><dt>{{t "result.stats.files"}}</dt><dd>{{runStats.fileCount}}</dd></div>
            <div><dt>{{t "result.stats.votes"}}</dt><dd>{{runStats.voteCount}}</dd></div>
            <div><dt>{{t "result.stats.sources"}}</dt><dd>{{runStats.sourceCount}}</dd></div>
          </dl>
        </section>
      {{/if}}
      {{> secondaryFiles extraClass="bento-stack-wide"}}
    </div>
    {{> coreOutputs}}
  {{else}}
    {{> nextStep}}
    {{> coreOutputs extraClass="span-8"}}
    {{> secondaryFiles extraClass="span-4 tile-fit"}}
  {{/if}}

  <div class="link-actions page-exit">
    <a href="/jobs/{{job.id}}">{{t "result.backProgress"}}</a>
    <a href="/">{{t "common.startAnother"}}</a>
  </div>
</div>
