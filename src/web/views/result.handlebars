<section class="panel">
  <h1>{{t "result.title"}}</h1>
  <nav aria-label="{{t "workflow.label"}}"><ol class="workflow-steps"><li class="is-complete">{{t "workflow.prepare"}}</li><li class="is-complete">{{t "workflow.run"}}</li><li aria-current="step">{{t "workflow.review"}}</li><li>{{t "workflow.publish"}}</li></ol></nav>
  <p class="lede">{{t "result.lede" id=job.id status=job.status}}</p>

  <dl class="details">
    <div><dt>{{t "common.action"}}</dt><dd>{{jobActionLabel}}</dd></div>
    <div><dt>{{t "common.challenge"}}</dt><dd>{{job.challenge}}</dd></div>
    <div><dt>{{t "common.output"}}</dt><dd><code>{{job.outputDir}}</code></dd></div>
  </dl>

  {{#if publishNotice}}
    <div class="notice">{{publishNotice}}</div>
  {{/if}}

  {{#if canPublishReview}}
    <section class="publish-review-cta">
      <div>
        <h2>{{t "publishReview.title"}}</h2>
        <p class="lede">{{t "result.publishCopy"}}</p>
      </div>
      <div class="actions">
        <a href="{{publishReviewUrl}}">{{t "result.reviewPublish" mode=publishModeLabel}}</a>
      </div>
    </section>
  {{else}}
    {{#if hasMaintenanceReview}}
      <section class="publish-review-cta">
        <div>
          <h2>{{t "maintenanceReview.title"}}</h2>
          <p class="lede">{{t "result.maintenanceCopy"}}</p>
        </div>
        <div class="actions">
          <a href="{{maintenanceReviewUrl}}">{{t "result.openMaintenance"}}</a>
        </div>
      </section>
    {{else}}
      <section class="publish-review-cta">
        <div>
          <h2>{{t "result.dryRunHeading"}}</h2>
          <p class="lede">{{t "result.dryRunCopy"}}</p>
        </div>
      </section>
    {{/if}}
  {{/if}}

  <h2>{{t "result.core"}}</h2>
  {{#if coreArtifacts.length}}
    <div class="artifact-grid">
      {{#each coreArtifacts}}
        <article class="artifact-card artifact-card-{{type}}">
          <p class="artifact-kicker">{{label}}</p>
          <h3><code>{{name}}</code></h3>
          <p class="artifact-copy">{{description}}</p>
          <div class="artifact-actions">
            <a href="{{previewUrl}}">{{t "common.preview"}}</a>
            <a href="{{downloadUrl}}">{{t "common.download"}}</a>
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <p>{{t "result.noCore"}}</p>
  {{/if}}

  <h2>{{t "result.other"}}</h2>
  {{#if generatedFiles.length}}
    <ul class="artifact-list">
      {{#each generatedFiles}}
        <li>
          <code>{{name}}</code>
          <span class="artifact-actions">
            <a href="{{previewUrl}}">{{t "common.preview"}}</a>
            <a href="{{downloadUrl}}">{{t "common.download"}}</a>
          </span>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p>{{t "result.noOther"}}</p>
  {{/if}}

  <h2>{{t "result.logs"}}</h2>
  {{#if logFiles.length}}
    <ul class="artifact-list">
      {{#each logFiles}}
        <li>
          <code>{{name}}</code>
          <span class="artifact-actions">
            <a href="{{previewUrl}}">{{t "common.preview"}}</a>
            <a href="{{downloadUrl}}">{{t "common.download"}}</a>
          </span>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p>{{t "result.noLogs"}}</p>
  {{/if}}

  <div class="actions">
    <a href="/jobs/{{job.id}}">{{t "result.backProgress"}}</a>
    <a href="/">{{t "common.startAnother"}}</a>
  </div>
</section>
