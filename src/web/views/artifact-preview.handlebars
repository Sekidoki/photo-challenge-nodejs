<section class="panel panel-wide">
  <div class="panel-header">
    <div>
      <h1>{{t "artifact.title"}}</h1>
      <p class="lede">{{t "artifact.lede" file=fileName id=job.id}}</p>
    </div>
    <div class="actions">
      <a href="{{downloadUrl}}">{{t "common.download"}}</a>
      <a href="/jobs/{{job.id}}/result">{{t "common.backToResult"}}</a>
    </div>
  </div>

  {{#if coreArtifacts.length}}
    <section class="preview-nav-card">
      <h2>{{t "artifact.core"}}</h2>
      <p class="lede">{{t "artifact.switchCopy"}}</p>
      <div class="preview-nav-grid">
        {{#each coreArtifacts}}
          <article class="preview-nav-item {{#if isActive}}preview-nav-item-active{{/if}}">
            <p class="artifact-kicker">{{label}}</p>
            <h3><code>{{name}}</code></h3>
            <p class="artifact-copy">{{description}}</p>
            <div class="preview-nav-actions">
              {{#if isActive}}
                <span class="preview-nav-current">{{t "artifact.current"}}</span>
              {{else}}
                <a class="preview-nav-link" href="{{previewUrl}}">{{t "artifact.open"}}</a>
              {{/if}}
              <a class="preview-nav-link preview-nav-link-secondary" href="{{downloadUrl}}">{{t "common.download"}}</a>
            </div>
          </article>
        {{/each}}
      </div>
    </section>
  {{/if}}

  <pre class="artifact-preview"><code>{{content}}</code></pre>
</section>
