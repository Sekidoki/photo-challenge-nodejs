<section class="panel">
  <div class="panel-header">
    <div>
      <h1>{{t "maintainers.heading"}}</h1>
      <p class="lede">{{t "maintainers.lede"}}</p>
    </div>
    <a href="/">{{t "maintainers.back"}}</a>
  </div>

  {{#if success}}<div class="notice">{{success}}</div>{{/if}}
  {{#if error}}<div class="alert">{{error}}</div>{{/if}}

  {{#if maintainers.length}}
    <section class="maintainer-overview">
      <h2>{{t "maintainers.current"}}</h2>
      <p class="lede">{{t "maintainers.currentCopy"}}</p>
      <div class="maintainer-list">
        {{#each maintainers}}
          <article class="maintainer-card">
            <div class="maintainer-card-copy">
              <div class="job-history-heading">
                <strong>{{userName}}</strong>
                <span class="status-pill {{#if isOwner}}status-owner{{else if isManager}}status-manager{{else}}status-maintainer{{/if}}">{{roleLabel}}</span>
              </div>
              {{#if isOwner}}
                <p class="job-history-meta">{{t "maintainers.ownerProtected"}}</p>
              {{else}}
                <p class="job-history-meta">{{t "maintainers.addedBy" name=addedBy}}</p>
              {{/if}}
            </div>
            <div class="maintainer-actions">
              {{#if canEdit}}
                <form method="post" action="/maintainers" class="inline-control-form">
                  <input type="hidden" name="csrfToken" value="{{../csrfToken}}" />
                  <input type="hidden" name="userName" value="{{userName}}" />
                  <label>
                    <span class="visually-hidden">{{t "maintainers.roleLabel" name=userName}}</span>
                    <select name="role">
                      <option value="maintainer" {{#unless isManager}}selected{{/unless}}>{{t "maintainers.role.maintainer"}}</option>
                      <option value="manager" {{#if isManager}}selected{{/if}}>{{t "maintainers.role.manager"}}</option>
                    </select>
                  </label>
                  <button type="submit" class="button-quiet">{{t "maintainers.saveRole"}}</button>
                </form>
              {{/if}}
              {{#if canRemove}}
                <form method="post" action="/maintainers/remove" class="inline-control-form">
                  <input type="hidden" name="csrfToken" value="{{../csrfToken}}" />
                  <input type="hidden" name="userName" value="{{userName}}" />
                  <button type="submit" class="button-destructive">{{t "maintainers.remove"}}</button>
                </form>
              {{/if}}
            </div>
          </article>
        {{/each}}
      </div>
    </section>

    <section class="maintainer-overview">
      <h2>{{t "maintainers.add"}}</h2>
      <p class="lede">{{#if actor.isOwner}}{{t "maintainers.addOwnerCopy"}}{{else}}{{t "maintainers.addManagerCopy"}}{{/if}}</p>
      <form method="post" action="/maintainers" class="maintainer-add-form">
        <input type="hidden" name="csrfToken" value="{{csrfToken}}" />
        <label>
          <span>{{t "maintainers.userName"}}</span>
          <input name="userName" type="text" required autocomplete="off" />
          <small>{{t "maintainers.userNameHelp"}}</small>
        </label>
        {{#if actor.isOwner}}
          <label>
            <span>{{t "maintainers.roleLabelPlain"}}</span>
            <select name="role">
              <option value="maintainer">{{t "maintainers.role.maintainer"}}</option>
              <option value="manager">{{t "maintainers.role.manager"}}</option>
            </select>
          </label>
        {{else}}
          <input type="hidden" name="role" value="maintainer" />
        {{/if}}
        <div class="form-actions"><button type="submit">{{t "maintainers.addAction"}}</button></div>
      </form>
    </section>
  {{/if}}
</section>
