<div class="bento" data-progress-page data-status-url="/jobs/{{job.id}}/status" data-initial-status="{{job.status}}" data-step-prefix="{{t "progress.stepPrefix"}}" data-completed-text="{{t "progress.completedSummary"}}" data-failed-text="{{t "progress.failedSummary"}}" data-retry-text="{{t "progress.updateFailed"}}" data-completed-suffix="{{t "workflow.completedSuffix"}}" data-failed-suffix="{{t "workflow.failedSuffix"}}">
  <header class="page-header">
    <h1>{{t "progress.title"}}</h1>
    {{> workflow-steps steps=workflowSteps}}
    <p class="lede" data-progress-summary tabindex="-1">{{#if isCompleted}}{{t "progress.completedSummary"}}{{else if isFailed}}{{t "progress.failedSummary"}}{{else}}{{t "progress.lede" status=statusLabel}}{{/if}}</p>
  </header>

  {{!-- The hero slot holds one of three states: the live progress tile, the
       completed hand-off, or (on failure) the error message itself. --}}
  <div class="message message-error failure-panel span-8 tile-fit" role="alert" data-progress-error {{#unless isFailed}}hidden{{/unless}}>
    <h2>{{t "progress.failedHeading"}}</h2>
    <p data-progress-hint>{{failureHint}}</p>
    <details>
      <summary>{{t "progress.errorDetail"}}</summary>
      <pre class="error-detail" data-progress-error-text>{{job.errorMessage}}</pre>
    </details>
    <p><a class="button-link button-primary" href="{{retryUrl}}">{{t "progress.retryWithSettings"}}</a></p>
  </div>

  <section class="tile span-8 tile-fit progress-status" aria-label="{{t "progress.label"}}" data-progress-status {{#if isFailed}}hidden{{/if}}>
    {{#if isCompleted}}
      <div class="next-step" data-terminal-actions>
        <h2>{{t "result.nextStep"}}</h2>
        <a class="button-link button-primary" href="/jobs/{{job.id}}/result">{{t "progress.fullResult"}}</a>
      </div>
    {{else}}
      <div class="progress-meta" aria-hidden="true"><span data-progress-step>{{t "progress.step" step=stepLabel}}</span><span data-progress-percent>{{job.percent}}%</span></div>
      <div class="progress-bar" role="progressbar" aria-label="{{t "progress.label"}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{job.percent}}" aria-valuetext="{{job.percent}}% · {{stepLabel}}"><div class="progress-fill" data-progress-fill style="width: {{job.percent}}%;"></div></div>
      <p class="poll-status" data-poll-status aria-live="polite"></p>
      <div class="poll-recovery" data-poll-recovery hidden><button type="button" class="button-quiet" data-progress-retry>{{t "progress.retry"}}</button><a href="">{{t "progress.manualRefresh"}}</a></div>
    {{/if}}
  </section>

  <div class="tile span-4 tile-fit">
    <dl class="details details-stacked">
      <div><dt>{{t "common.challenge"}}</dt><dd>{{job.challenge}}</dd></div>
      <div><dt>{{t "common.action"}}</dt><dd>{{jobActionLabel}}</dd></div>
      {{#unless oauthConfigured}}<div><dt>{{t "common.output"}}</dt><dd>{{> copy-path path=job.outputDir}}</dd></div>{{/unless}}
    </dl>
  </div>

  <div class="tile">
    <details class="run-log" {{#unless isCompleted}}open{{/unless}} data-run-log>
      <summary>{{t "progress.messages"}}</summary>
      <ul class="messages" data-progress-messages>{{#each job.messages}}<li>{{this}}</li>{{/each}}</ul>
    </details>
  </div>
  <div class="link-actions page-exit"><a href="/">{{t "common.startAnother"}}</a></div>
</div>
<script src="/static/progress.js?v={{assetVersion}}" defer></script>
