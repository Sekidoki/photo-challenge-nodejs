<section class="panel">
  <div class="panel-header">
    <div>
      <h1>{{t "app.runner"}}</h1>
      <p class="lede">{{t "home.lede"}}</p>
    </div>
    <a class="github-link" href="https://github.com/Sekidoki/photo-challenge-nodejs/issues/new/choose" target="_blank" rel="noopener noreferrer">
      <svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.5 5.7.4.4.8 1.1.8 2.1v3.1c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z"/></svg>
      <span>{{t "home.reportIssue"}}</span>
    </a>
  </div>
  <nav aria-label="{{t "workflow.label"}}"><ol class="workflow-steps"><li aria-current="step">{{t "workflow.prepare"}}</li><li>{{t "workflow.run"}}</li><li>{{t "workflow.review"}}</li><li>{{t "workflow.publish"}}</li></ol></nav>

  {{#if oauthConfigured}}
    <section class="credential-card">
      <h2>{{t "home.oauth.heading"}}</h2>
      {{#if oauthUser}}
        <p class="lede">{{t "home.oauth.signedInCopy"}}</p>
        <dl class="details details-compact">
          <div><dt>{{t "common.account"}}</dt><dd><code>{{oauthUser.name}}</code></dd></div>
          <div><dt>{{t "home.oauth.storage"}}</dt><dd>{{t "home.oauth.sessionOnly"}}</dd></div>
        </dl>
      {{else}}
        <p class="lede">{{t "home.oauth.signedOutCopy"}}</p>
        <div class="form-actions"><a class="button-link" href="/auth/login">{{t "account.signIn"}}</a></div>
      {{/if}}
    </section>
  {{else}}
    <section class="credential-card">
      <h2>{{t "home.local.heading"}}</h2>
      <p class="lede">{{t "home.local.copy"}}</p>
      <dl class="details details-compact">
        <div><dt>{{t "home.local.storage"}}</dt><dd>{{credentialStore.backendLabel}}</dd></div>
        <div><dt>{{t "home.local.persists"}}</dt><dd>{{#if credentialStore.canPersistAcrossRestarts}}{{t "common.yes"}}{{else}}{{t "home.local.sessionOnly"}}{{/if}}</dd></div>
        <div><dt>{{t "home.local.savedName"}}</dt><dd>{{#if savedCredential}}<code>{{savedCredential.name}}</code>{{else}}{{t "home.local.noSaved"}}{{/if}}</dd></div>
      </dl>
      {{#if savedCredential}}
        <form method="post" action="/credentials/clear" class="inline-form-actions" data-confirm="{{t "home.local.confirmClear" name=savedCredential.name}}">
          <input type="hidden" name="name" value="{{savedCredential.name}}" />
          <button type="submit" data-processing-text="{{t "common.processing"}}" class="button-quiet">{{t "home.local.clear"}}</button>
        </form>
      {{/if}}
    </section>
    {{#if oauthConfigurationMessage}}<div class="notice">{{oauthConfigurationMessage}}</div>{{/if}}
  {{/if}}

  {{#if recentCompletedJob}}
    <section class="recent-job-card">
      <div class="panel-header">
        <div>
          <h2>{{t "home.recentCompleted.heading"}}</h2>
          <p class="lede">{{t "home.recentCompleted.copy"}}</p>
        </div>
        <div class="actions">
          <a href="{{recentCompletedJob.resultUrl}}">{{t "home.openResult"}}</a>
          <a href="{{recentCompletedJob.progressUrl}}">{{t "home.openProgress"}}</a>
        </div>
      </div>
      <dl class="details details-compact">
        <div><dt>{{t "common.challenge"}}</dt><dd>{{recentCompletedJob.challenge}}</dd></div>
        <div><dt>{{t "common.action"}}</dt><dd>{{recentCompletedJob.action}}</dd></div>
        <div><dt>{{t "home.finished"}}</dt><dd>{{recentCompletedJob.finishedAtLabel}}</dd></div>
        <div><dt>{{t "home.jobId"}}</dt><dd><code>{{recentCompletedJob.id}}</code></dd></div>
      </dl>
    </section>
  {{/if}}

  {{#if recentJobs.length}}
    <section class="recent-history-card">
      <h2>{{t "home.recent.heading"}}</h2>
      <p class="lede">{{t "home.recent.copy"}}</p>
      <ul class="job-history-list">
        {{#each recentJobs}}
          <li class="job-history-item">
            <div class="job-history-copy">
              <div class="job-history-heading">
                <strong>{{challenge}}</strong>
                <span class="status-pill {{statusClass}}">{{statusLabel}}</span>
              </div>
              <p class="job-history-meta">{{action}} · {{currentStep}}</p>
              <p class="job-history-meta">{{timestampLabel}}</p>
            </div>
            <div class="artifact-actions">
              <a href="{{progressUrl}}">{{t "home.progress"}}</a>
              {{#if (eq statusCode "completed")}}<a href="{{resultUrl}}">{{t "home.result"}}</a>{{/if}}
            </div>
          </li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  {{#if success}}<div class="notice">{{success}}</div>{{/if}}
  {{#if errorSummary.length}}
    <div class="alert error-summary" tabindex="-1" data-error-summary>
      <strong>{{t "home.error.summary"}}</strong>
      <ul>{{#each errorSummary}}<li><a href="#{{field}}">{{message}}</a></li>{{/each}}</ul>
    </div>
  {{else if error}}<div class="alert">{{error}}</div>{{/if}}

  <form method="post" action="/jobs" class="form-grid" data-dashboard-form>
    {{#if oauthConfigured}}<input type="hidden" name="csrfToken" value="{{csrfToken}}" />{{/if}}
    {{#unless oauthConfigured}}
      <label for="name">
        <span>{{t "home.local.name"}}</span>
        <input id="name" name="name" type="text" value="{{defaults.name}}" required autocomplete="username" {{#if fieldErrors.name}}aria-invalid="true" aria-describedby="name-error name-help"{{else}}aria-describedby="name-help"{{/if}} />
        {{#if fieldErrors.name}}<small id="name-error" class="field-error">{{fieldErrors.name}}</small>{{/if}}<small id="name-help">{{t "home.local.nameHelp"}}</small>
      </label>
      <label for="botPassword">
        <span>{{t "home.local.password"}}</span>
        <input id="botPassword" name="botPassword" type="password" autocomplete="current-password" {{#unless savedCredential}}required{{/unless}} {{#if fieldErrors.botPassword}}aria-invalid="true" aria-describedby="botPassword-error botPassword-help"{{else}}aria-describedby="botPassword-help"{{/if}} />
        {{#if fieldErrors.botPassword}}<small id="botPassword-error" class="field-error">{{fieldErrors.botPassword}}</small>{{/if}}<small id="botPassword-help">{{#if savedCredential}}{{t "home.local.passwordSavedHelp" name=savedCredential.name}}{{else}}{{t "home.local.passwordHelp"}}{{/if}}</small>
      </label>
      <label class="checkbox-row">
        <input name="rememberCredential" type="checkbox" value="true" {{#if credentialStore.canPersistAcrossRestarts}}checked{{/if}} />
        <span>{{t "home.local.remember"}}</span>
      </label>
    {{/unless}}

    <label for="challenge">
      <span>{{t "common.challenge"}}</span>
      <input id="challenge" name="challenge" type="text" value="{{defaults.challenge}}" placeholder="{{t "home.challenge.placeholder"}}" required {{#if fieldErrors.challenge}}aria-invalid="true" aria-describedby="challenge-error"{{/if}} />
      {{#if fieldErrors.challenge}}<small id="challenge-error" class="field-error">{{fieldErrors.challenge}}</small>{{/if}}
    </label>

    <fieldset class="action-picker">
      <legend>{{t "home.workflow.heading"}}</legend>
      <p class="action-picker-copy">{{t "home.workflow.copy"}}</p>
      <div class="task-card-grid">
        <label class="action-card">
          <input name="action" type="radio" value="create-voting" {{#if (eq defaults.action "create-voting")}}checked{{/if}} />
          <span class="action-card-body">
            <span class="action-card-title">{{t "home.workflow.voting.title"}}</span>
            <span class="action-card-text">{{t "home.workflow.voting.text"}}</span>
            <span class="action-card-meta">{{t "home.workflow.voting.meta"}}</span>
          </span>
        </label>
        <label class="action-card">
          <input name="action" type="radio" value="count-votes-and-select-winners" {{#if (eq defaults.action "count-votes-and-select-winners")}}checked{{/if}} />
          <span class="action-card-body">
            <span class="action-card-title">{{t "home.workflow.count.title"}}</span>
            <span class="action-card-text">{{t "home.workflow.count.text"}}</span>
            <span class="action-card-meta">{{t "home.workflow.count.meta"}}</span>
          </span>
        </label>
        <label class="action-card">
          <input name="action" type="radio" value="post-results-maintenance" {{#if (eq defaults.action "post-results-maintenance")}}checked{{/if}} />
          <span class="action-card-body">
            <span class="action-card-title">{{t "home.workflow.maintenance.title"}}</span>
            <span class="action-card-text">{{t "home.workflow.maintenance.text"}}</span>
            <span class="action-card-meta">{{t "home.workflow.maintenance.meta"}}</span>
          </span>
        </label>
      </div>
    </fieldset>

    <div class="workflow-settings" aria-live="polite">
      <section data-workflow-settings="create-voting">
        <h2>{{t "home.voting.heading"}}</h2>
        <p class="action-picker-copy">{{t "home.voting.copy"}}</p>
        <div class="settings-grid">
          <label>
            <span>{{t "home.voting.entryMode"}}</span>
            <select name="entryMode">
              <option value="single" {{#if (eq defaults.entryMode "single")}}selected{{/if}}>{{t "home.voting.single"}}</option>
              <option value="duo-coequal" {{#if (eq defaults.entryMode "duo-coequal")}}selected{{/if}}>{{t "home.voting.duoCoequal"}}</option>
              <option value="duo-reference" {{#if (eq defaults.entryMode "duo-reference")}}selected{{/if}}>{{t "home.voting.duoReference"}}</option>
            </select>
            <small>{{t "home.voting.entryModeHelp"}}</small>
          </label>
          <label for="submissionStart">
            <span>{{t "home.voting.start"}}</span>
            <input id="submissionStart" name="submissionStart" type="datetime-local" value="{{defaults.submissionStart}}" aria-describedby="submissionStart-help{{#if fieldErrors.submissionStart}} submissionStart-error{{/if}}" {{#if fieldErrors.submissionStart}}aria-invalid="true"{{/if}} />
            {{#if fieldErrors.submissionStart}}<small id="submissionStart-error" class="field-error">{{fieldErrors.submissionStart}}</small>{{/if}}<small id="submissionStart-help">{{t "home.voting.startHelp"}}</small>
          </label>
          <label for="submissionEnd">
            <span>{{t "home.voting.end"}}</span>
            <input id="submissionEnd" name="submissionEnd" type="datetime-local" value="{{defaults.submissionEnd}}" aria-describedby="submissionEnd-help{{#if fieldErrors.submissionEnd}} submissionEnd-error{{/if}}" {{#if fieldErrors.submissionEnd}}aria-invalid="true"{{/if}} />
            {{#if fieldErrors.submissionEnd}}<small id="submissionEnd-error" class="field-error">{{fieldErrors.submissionEnd}}</small>{{/if}}<small id="submissionEnd-help">{{t "home.voting.endHelp"}}</small>
          </label>
          <p class="settings-timezone">{{t "home.voting.timezone"}}</p>
        </div>
      </section>
      <section data-workflow-settings="count-votes-and-select-winners">
        <h2>{{t "home.settings.heading"}}</h2>
        <p class="action-picker-copy">{{t "home.noExtraSettings"}}</p>
      </section>
      <section data-workflow-settings="post-results-maintenance">
        <h2>{{t "home.settings.heading"}}</h2>
        <label>
          <span>{{t "home.maintenance.paired"}}</span>
          <input name="pairedChallenge" type="text" value="{{defaults.pairedChallenge}}" placeholder="{{t "home.maintenance.pairedPlaceholder"}}" />
          <small>{{t "home.maintenance.pairedHelp"}}</small>
        </label>
      </section>
    </div>

    <fieldset class="action-picker">
      <legend>{{t "home.publishMode.heading"}}</legend>
      <p class="action-picker-copy">{{t "home.publishMode.copy"}}</p>
      <div class="task-card-grid">
        <label class="action-card">
          <input name="publishMode" type="radio" value="dry-run" {{#if (eq defaults.publishMode "dry-run")}}checked{{/if}} />
          <span class="action-card-body"><span class="action-card-title">{{t "home.publishMode.dryRun.title"}}</span><span class="action-card-text">{{t "home.publishMode.dryRun.text"}}</span><span class="action-card-meta">{{t "home.publishMode.dryRun.meta"}}</span></span>
        </label>
        <label class="action-card">
          <input name="publishMode" type="radio" value="sandbox" {{#if (eq defaults.publishMode "sandbox")}}checked{{/if}} />
          <span class="action-card-body"><span class="action-card-title">{{t "home.publishMode.sandbox.title"}}</span><span class="action-card-text">{{t "home.publishMode.sandbox.text"}}</span><span class="action-card-meta">{{t "home.publishMode.sandbox.meta"}}</span></span>
        </label>
        <label class="action-card">
          <input name="publishMode" type="radio" value="live" {{#if (eq defaults.publishMode "live")}}checked{{/if}} />
          <span class="action-card-body"><span class="action-card-title">{{t "home.publishMode.live.title"}}</span><span class="action-card-text">{{t "home.publishMode.live.text"}}</span><span class="action-card-meta action-card-meta--warn">{{t "home.publishMode.live.meta"}}</span></span>
        </label>
      </div>
    </fieldset>

    <div class="notice inline-notice">{{t "home.maintenance.note"}}</div>
    <div class="form-actions">
      <button type="submit" data-processing-text="{{t "home.starting"}}" {{#if oauthConfigured}}{{#unless oauthUser}}disabled{{/unless}}{{/if}}>{{t "home.start"}}</button>
      {{#if oauthConfigured}}{{#unless oauthUser}}<a class="button-link" href="/auth/login">{{t "home.signInToContinue"}}</a>{{/unless}}{{/if}}
    </div>
  </form>
</section>
