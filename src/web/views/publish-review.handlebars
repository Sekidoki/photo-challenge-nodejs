<section class="panel panel-wide">
  <div class="panel-header">
    <div>
      <h1>{{t "publishReview.title"}}</h1>
      <p class="lede">{{t "publishReview.lede" mode=publishContext.modeLabel}}</p>
    </div>
    <div class="actions">
      <a href="{{alternateModeUrl}}">{{t "publishReview.switch" mode=alternateModeLabel}}</a>
      <a href="/jobs/{{job.id}}/result">{{t "common.backToResult"}}</a>
    </div>
  </div>

  <dl class="details">
    <div><dt>{{t "common.action"}}</dt><dd>{{jobActionLabel}}</dd></div>
    <div><dt>{{t "common.challenge"}}</dt><dd>{{job.challenge}}</dd></div>
    <div><dt>{{t "publishReview.mode"}}</dt><dd>{{publishContext.modeLabel}}</dd></div>
  </dl>

  <aside class="publish-safety-summary {{#if publishContext.isLive}}publish-safety-summary-live{{else}}publish-safety-summary-sandbox{{/if}}" aria-labelledby="publish-safety-title">
    <h2 id="publish-safety-title">{{t "safety.heading"}}</h2>
    <dl class="publish-safety-grid">
      <div><dt>{{t "common.account"}}</dt><dd><code>{{publishContext.accountName}}</code></dd></div>
      <div><dt>{{t "common.wiki"}}</dt><dd>{{publishContext.wikiLabel}}</dd></div>
      <div><dt>{{t "common.mode"}}</dt><dd><strong>{{publishContext.modeLabel}}</strong></dd></div>
      <div><dt>{{t "safety.targetCount"}}</dt><dd>{{publishContext.targetCount}}</dd></div>
    </dl>
    <p>{{#if publishContext.isLive}}{{t "safety.liveWarning"}}{{else}}{{t "safety.sandboxWarning"}}{{/if}}</p>
  </aside>

  {{#if reviewNotice}}
    <div class="notice">{{reviewNotice}}</div>
  {{/if}}

  {{#if reviewWarning}}
    <div class="alert">{{reviewWarning}}</div>
  {{/if}}

  <h2>{{t "common.targets"}}</h2>
  {{#if reviewEntries.length}}
    <div class="publish-review-list">
      {{#each reviewEntries}}
        <article class="publish-review-card publish-review-card-{{status}}">
          <div class="publish-review-header">
            <div>
              <p class="artifact-kicker">{{label}}</p>
              <h3><code>{{fileName}}</code></h3>
            </div>
            <span class="status-pill publish-status-{{status}}">{{statusLabel}}</span>
          </div>

          <p class="publish-target"><strong>{{t "publishReview.target"}}:</strong> <code>{{targetTitle}}</code></p>
          <p class="artifact-copy">{{summary}}</p>

          <div class="artifact-actions">
            <a href="{{previewUrl}}">{{t "publishReview.previewFile"}}</a>
            <a href="{{downloadUrl}}">{{t "common.download"}}</a>
          </div>

          <section class="diff-table-wrap">
            <div class="diff-table-head">
              <span>{{t "publishReview.currentTarget"}}</span>
              <span>{{t "publishReview.generatedOutput"}}{{#if firstDifferenceLine}} {{t "publishReview.fromLine" line=firstDifferenceLine}}{{/if}}</span>
            </div>
            <div class="diff-table">
              {{#each diffRows}}
                <div class="diff-row diff-row-{{kind}}">
                  {{#if isSkip}}
                    <div class="diff-cell diff-cell-skip" colspan="2">{{nextText}}</div>
                  {{else}}
                    <div class="diff-cell diff-cell-current">
                      <span class="diff-line-no">{{#if currentLineNumber}}{{currentLineNumber}}{{else}}&nbsp;{{/if}}</span>
                      <pre class="diff-line-text">{{currentText}}</pre>
                    </div>
                    <div class="diff-cell diff-cell-next">
                      <span class="diff-line-no">{{#if nextLineNumber}}{{nextLineNumber}}{{else}}&nbsp;{{/if}}</span>
                      <pre class="diff-line-text">{{nextText}}</pre>
                    </div>
                  {{/if}}
                </div>
              {{/each}}
            </div>
          </section>
        </article>
      {{/each}}
    </div>

    <form method="post" action="/jobs/{{job.id}}/publish" class="publish-form" data-confirm="{{#if publishContext.isLive}}{{t "safety.confirmLive" account=publishContext.accountName wiki=publishContext.wikiLabel count=publishContext.targetCount}}{{else}}{{t "safety.confirmSandbox" account=publishContext.accountName count=publishContext.targetCount}}{{/if}}">
      <input type="hidden" name="csrfToken" value="{{csrfToken}}">
      <input type="hidden" name="mode" value="{{reviewMode}}">
      <div class="actions">
        <button type="submit" data-processing-text="{{t "common.processing"}}" class="{{#if publishContext.isLive}}button-destructive{{/if}}">{{t "publishReview.publish" mode=publishContext.modeLabel}}</button>
        <a href="/jobs/{{job.id}}/result">{{t "common.cancel"}}</a>
      </div>
    </form>
  {{else}}
    <p>{{t "publishReview.none"}}</p>
  {{/if}}
</section>
