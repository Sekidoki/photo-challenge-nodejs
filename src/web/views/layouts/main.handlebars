<!DOCTYPE html>
<html lang="{{htmlLang}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/static/codex/theme-wikimedia-ui.css?v=2.7.0" />
    <link rel="stylesheet" href="/static/codex/theme-wikimedia-ui-mode-dark.css?v=2.7.0" media="(prefers-color-scheme: dark)" />
    <link rel="stylesheet" href="/static/styles.css?v={{assetVersion}}" />
    <script src="/static/dashboard.js?v={{assetVersion}}" defer></script>
    <script src="/static/web-vitals/web-vitals.iife.js?v=6.2.3" defer></script>
    <script src="/static/rum.js?v={{assetVersion}}" defer></script>
  </head>
  <body data-dismiss-label="{{t "notice.dismiss"}}">
    <a class="skip-link" href="#main-content">{{t "accessibility.skipToContent"}}</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href="/">{{t "app.name"}}</a>
        <div class="site-header-tools">
          <nav class="language-switcher" aria-label="{{t "language.label"}}">
            <a href="{{languageLinks.en}}" lang="en" hreflang="en"{{#if (eq locale "en")}} aria-current="true"{{/if}}>{{t "language.english"}}</a>
            <a href="{{languageLinks.zhTW}}" lang="zh-TW" hreflang="zh-TW"{{#if (eq locale "zh-TW")}} aria-current="true"{{/if}}>{{t "language.traditionalChinese"}}</a>
          </nav>
          {{#if oauthConfigured}}
          <nav class="site-account" aria-label="{{t "account.navigation"}}">
          {{#if oauthUser}}
            <span>{{t "account.signedInAs" name=oauthUser.name}}</span>
            {{#if oauthUser.canManageMaintainers}}
              <a href="/maintainers">{{t "account.manageMaintainers"}}</a>
            {{/if}}
            <form method="post" action="/auth/logout">
              <input type="hidden" name="csrfToken" value="{{csrfToken}}" />
              <button type="submit" class="button-quiet button-small">{{t "account.signOut"}}</button>
            </form>
          {{else}}
            <a href="/auth/login">{{t "account.signIn"}}</a>
          {{/if}}
          </nav>
          {{/if}}
        </div>
      </div>
    </header>
    <main class="shell" id="main-content" tabindex="-1">
      {{{body}}}
    </main>
    <footer class="site-footer">
      <a href="https://commons.wikimedia.org/wiki/Commons:Photo_challenge" target="_blank" rel="noopener noreferrer">{{t "home.footer.commons"}}<span class="visually-hidden"> ({{t "accessibility.opensNewTab"}})</span></a>
      <a href="https://github.com/Sekidoki/photo-challenge-nodejs/issues/new/choose" target="_blank" rel="noopener noreferrer">{{t "home.footer.reportIssue"}}<span class="visually-hidden"> ({{t "accessibility.opensNewTab"}})</span></a>
    </footer>
  </body>
</html>
