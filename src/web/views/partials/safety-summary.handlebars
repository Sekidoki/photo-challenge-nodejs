{{#if context.isLive}}<div class="message message-warning">{{t "safety.liveWarning"}}</div>{{/if}}
<section class="safety-strip{{#if context.isLive}} safety-strip-live{{/if}}" aria-labelledby="{{headingId}}">
  <h2 id="{{headingId}}">{{t "safety.heading"}}</h2>
  <div class="tile safety-mode{{#if context.isLive}} safety-mode-live{{/if}}">
    <dl class="safety-fact">
      <dt>{{t "common.mode"}}</dt>
      <dd class="safety-lead">{{context.modeLabel}}</dd>
      <dt>{{t "common.challenge"}}</dt>
      <dd>{{challenge}}</dd>
    </dl>
    {{#unless context.isLive}}<p class="lede">{{t "safety.sandboxWarning"}}</p>{{/unless}}
    <p class="mode-control"><a class="button-link" data-mode-switch {{#if preserveSelections}}data-preserve-selections{{/if}} data-mode-message="{{t "publishReview.modeChanged" mode=alternateModeLabel}}" href="{{alternateModeUrl}}">{{t "publishReview.switch" mode=alternateModeLabel}}</a></p>
  </div>
  <div class="tile safety-account">
    <dl class="safety-fact"><dt>{{t "common.account"}}</dt><dd><code>{{context.accountName}}</code></dd></dl>
  </div>
  <div class="tile safety-wiki">
    <dl class="safety-fact"><dt>{{t "common.wiki"}}</dt><dd>{{context.wikiLabel}}</dd></dl>
  </div>
  <div class="tile safety-targets">
    <dl class="safety-fact"><dt>{{t "safety.targetCount"}}</dt><dd class="safety-lead">{{context.targetCount}}</dd></dl>
    {{#if targets.length}}
      <ul class="safety-target-list">
        {{#each targets}}<li><a href="#target-{{@index}}">{{label}}</a> <span class="status-pill publish-status-{{status}}">{{statusLabel}}</span></li>{{/each}}
      </ul>
    {{/if}}
  </div>
</section>
